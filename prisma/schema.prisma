generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id             Int            @id @default(autoincrement())
  full_name      String         @db.VarChar(100)
  role           user_role?     @default(customer)
  email          String         @unique @db.VarChar(100)
  phone          String         @unique @db.VarChar(100)
  date_of_birth  DateTime?      @db.Date
  address        String?        @db.VarChar(100)
  state          String?        @db.VarChar(100)
  district       String?        @db.VarChar(100)
  municipality   String?        @db.VarChar(100)
  preferences    Json?
  status         user_status?   @default(pending)
  password       String?        @db.VarChar(200)
  avatar         String?        @db.VarChar(200)
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  updated_at     DateTime?      @default(now()) @db.Timestamp(6)
  refresh_token  String?        @db.VarChar(200)
  oauth_provider user_provider? @default(none)
  oauth_id       String?        @db.VarChar(200)
  bookings       bookings[]
  complaints     complaints[]
  reviews        reviews[]
  venues         venues[]
}

model venues {
  id           Int             @id @default(autoincrement())
  name         String          @db.VarChar(150)
  description  String?
  category     venue_category? @default(wedding)
  address      String          @db.VarChar(100)
  state        String          @db.VarChar(100)
  district     String          @db.VarChar(100)
  municipality String          @db.VarChar(100)
  capacity     Int
  price        Decimal         @db.Decimal(10, 2)
  amenities    Json?
  is_active    Boolean?        @default(false)
  is_available Boolean?        @default(true)
  created_at   DateTime?       @default(now()) @db.Timestamp(6)
  updated_at   DateTime?       @default(now()) @db.Timestamp(6)
  admin_id  Int      @unique
  bookings     bookings[]
  complaints   complaints[]
  images       images[]
  reviews      reviews[]
  venue_visits venue_visits[]
  users        users?          @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model images {
  id         Int       @id @default(autoincrement())
  image_url  String    @db.VarChar(200)
  title      String    @db.VarChar(100)
  is_cover   Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  venue_id   Int?
  venues     venues?   @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id          Int            @id @default(autoincrement())
  rating      Int?
  comment     String?
  status      review_status? @default(active)
  image       String?        @db.VarChar(200)
  created_at  DateTime?      @default(now()) @db.Timestamp(6)
  customer_id Int?
  venue_id    Int?
  users       users?         @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  venues      venues?        @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model bookings {
  id                 Int                 @id @default(autoincrement())
  event_date         DateTime            @db.Date
  attendances        Int
  payment_status     payment_status_enum
  payment_method     payment_method_enum
  status             event_status_enum
  notes              String?
  check_in_at        DateTime?           @db.Time(6)
  check_out_at       DateTime?           @db.Time(6)
  canceled           Boolean?            @default(false)
  cancelation_reason String?
  created_at         DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  updated_at         DateTime?           @default(dbgenerated("CURRENT_DATE")) @db.Date
  customer_id        Int?
  venue_id           Int?
  users              users?              @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer")
  venues             venues?             @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_venue")
}

model complaints {
  id          Int               @id @default(autoincrement())
  subject     String            @db.VarChar(150)
  message     String
  status      complaint_status? @default(sent)
  created_at  DateTime?         @default(dbgenerated("CURRENT_DATE")) @db.Date
  customer_id Int?
  location_id Int?
  users       users?            @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer")
  venues      venues?           @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_location")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model feedbacks {
  name    String? @db.VarChar(200)
  email   String? @db.VarChar(200)
  message String

  @@ignore
}

model venue_visits {
  id         Int       @id @default(autoincrement())
  venue_id   Int
  visited_at DateTime? @default(now()) @db.Timestamp(6)
  venues     venues    @relation(fields: [venue_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum user_provider {
  none
  facebook
  google
}

enum user_role {
  customer
  location_admin
  website_admin
}

enum user_status {
  pending
  active
  banned
}

enum venue_category {
  wedding
  party
  conference
  exhibition
  sports
  cultural
}

enum review_status {
  active
  banned
}

enum event_status_enum {
  pending
  confirmed
  cancelled
  completed
}

enum payment_method_enum {
  dahabia
  ccp
  bank_transfer
  cash
}

enum payment_status_enum {
  pending
  paid
  refunded
}

enum complaint_status {
  sent
  open_in
  in_progress
}
